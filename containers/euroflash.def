Bootstrap: docker
From: python:3.11-slim-trixie

%labels
    Description LOTAAS EuroFlash CPU and CUDA search environment

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends build-essential gfortran f2c libf2c2-dev git ca-certificates
    python -m pip install --no-cache-dir \
        numpy==1.26.4 scipy==1.13.1 matplotlib==3.9.4 pandas==2.2.3 \
        astropy==6.1.7 scikit-learn==1.5.2 PyYAML==6.0.2 tqdm==4.67.1 \
        requests==2.32.4 h5py==3.12.1 pytest==8.3.5 \
        cupy-cuda12x==13.6.0 nvidia-cuda-runtime-cu12==12.8.90 \
        nvidia-cuda-nvrtc-cu12==12.8.93 nvidia-cuda-nvcc-cu12==12.8.93 \
        nvidia-cufft-cu12==11.3.3.83 iqrm==0.2.0 psrqpy==1.3.2 \
        tensorflow-cpu==2.15.1 pygedm==3.3.0
    python -m pip install --no-cache-dir \
        git+https://github.com/DirkKuiper/your.git@62afec9432758f7151ec5cf50e3200dc388675c8 \
        git+https://github.com/devanshkv/fetch.git@5b85488f93c199f6a2efc8b2060defc84080f54a
    python -m pip freeze > /opt/lotaas-environment.lock
    rm -rf /var/lib/apt/lists/*

%environment
    export LD_LIBRARY_PATH=/usr/local/lib/python3.11/site-packages/nvidia/cuda_runtime/lib:/usr/local/lib/python3.11/site-packages/nvidia/cuda_nvrtc/lib:/usr/local/lib/python3.11/site-packages/nvidia/cufft/lib:/usr/local/lib/python3.11/site-packages/nvidia/nvjitlink/lib:${LD_LIBRARY_PATH:-}
    export MPLBACKEND=Agg
    export PYTHONUNBUFFERED=1
    export OMP_NUM_THREADS=1
    export OPENBLAS_NUM_THREADS=1
    export TF_NUM_INTRAOP_THREADS=1
    export TF_NUM_INTEROP_THREADS=1

%test
    python -c 'import numpy, scipy, astropy, cupy, pandas, sklearn, requests, your, pygedm; print("LOTAAS imports OK")'

%runscript
    exec python "$@"
